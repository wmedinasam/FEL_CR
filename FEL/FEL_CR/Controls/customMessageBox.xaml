<Window x:Class="FELCR.Controls.customMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:FELCR.Controls"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Height="220" Width="420">
    <Border x:Name="MainContainer"
        Background="#1E2634"
        CornerRadius="12"
        Padding="20"
        Effect="{DynamicResource MaterialDesignShadowDepth3}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Icono animado mejorado -->
            <Grid Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0 0 10 0">
                <Path x:Name="AnimatedIcon"
                  Fill="#2196F3"
                  Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm1-13h-2v6h2zm0 8h-2v2h2z"
                  Width="48"
                  Height="48"
                  Stretch="Uniform">
                    <Path.RenderTransform>
                        <ScaleTransform ScaleX="0.7" ScaleY="0.7" CenterX="24" CenterY="24"/>
                    </Path.RenderTransform>
                    <Path.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.3"/>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.3"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Path.Triggers>
                </Path>
            </Grid>

            <!-- Título + Mensaje juntos -->
            <StackPanel Grid.Row="0" Grid.RowSpan="2"
        Grid.Column="1"
        VerticalAlignment="Center"
        Margin="0,0,10,0">
                <TextBlock x:Name="TxtTitle"
                   Text="¡Atención!"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0 0 0 5"/>
                <TextBlock x:Name="TxtMessage"
               Text="Mensaje de ejemplo"
               TextWrapping="Wrap"
               Foreground="#D6D6D6"
               FontSize="14"/>
            </StackPanel>

            <!-- Botones -->
            <StackPanel x:Name="ButtonPanel"
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0 20 0 0">
                <Button x:Name="BtnCancel"
                    Content="Cancelar"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Margin="0 0 10 0"
                    Width="100"
                    Click="BtnCancel_Click"/>

                <Button x:Name="BtnOk"
                    Content="Aceptar"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="{DynamicResource PrimaryBlueColor}"
                    Foreground="White"
                    Width="100"
                    Click="BtnOk_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
