<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Background Colors -->
    <SolidColorBrush x:Key="PrimaryBackgroundColor" Color="#131725"/>
    <SolidColorBrush x:Key="SecundaryBackgroundColor" Color="#1d2335"/>

    <!-- Primary Colors -->
    <SolidColorBrush x:Key="PrimaryBlueColor" Color="#3772FF"/>

    <!-- Typograhy Colors -->
    <SolidColorBrush x:Key="PrimaryTextColor" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecundaryColor" Color="#B0B7C3"/>
    <SolidColorBrush x:Key="TextTertiaryColor" Color="#8A94A6"/>
    <SolidColorBrush x:Key="TextFourthColor" Color="#4B5D78"/>

    <!-- Icon Colors -->
    <SolidColorBrush x:Key="PrimaryIconColor" Color="#B0B7C3"/>
    <SolidColorBrush x:Key="SecundaryIconColor" Color="#8A94A6"/>
    <SolidColorBrush x:Key="TertiarIconyColor" Color="#4B5D78"/>
    <SolidColorBrush x:Key="FourthIconColor" Color="#323B4B"/>

    <!-- Special Colors -->
    <SolidColorBrush x:Key="DangerColor" Color="#f8d7da"/>
    <SolidColorBrush x:Key="DangerTextColor" Color="#721c24"/>
    <SolidColorBrush x:Key="SuccessColor" Color="#d4edda"/>
    <SolidColorBrush x:Key="SuccessTextColor" Color="#d4edda"/>
    <SolidColorBrush x:Key="WarningColor" Color="#fff3cd"/>
    <SolidColorBrush x:Key="WarningTextColor" Color="#856404"/>
    <SolidColorBrush x:Key="InformationColor" Color="#d1ecf1"/>
    <SolidColorBrush x:Key="InformationTextColor" Color="#0c5460"/>
    <LinearGradientBrush x:Key="Danger1" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FFFC0909"/>
        <GradientStop Color="#FF242A40" Offset="0.449"/>
        <GradientStop Color="#FFD00314"/>
        <GradientStop Color="#FF910509" Offset="0.024"/>
        <GradientStop Color="#FF362336" Offset="0.341"/>
        <GradientStop Color="#FF4C1C2A" Offset="0.243"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="btnClose" Color="#F72626"/>
</ResourceDictionary>