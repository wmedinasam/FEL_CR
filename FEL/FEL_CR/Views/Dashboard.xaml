<Window x:Class="FELCR.Views.Dashboard"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:ctls="clr-namespace:FELCR.Controls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FELCR.Views"
        xmlns:pages="clr-namespace:FELCR.Views.Pages"
        mc:Ignorable="d"
        Title="Dashboard" 
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None"
        Background="Transparent" 
        AllowsTransparency="True"
        ResizeMode="CanResize" 
        FontFamily="Poppins"
        IsVisibleChanged="Window_IsVisibleChanged"
        StateChanged="Window_StateChanged"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        >
    <Window.DataContext>
        <pages:Monitor/>
    </Window.DataContext>

    <Border Background="{DynamicResource PrimaryBackgroundColor}"
CornerRadius="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="327*"/>
                <ColumnDefinition Width="143*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
        Background="{DynamicResource SecundaryBackgroundColor}"
        CornerRadius="8 0 0 8">
                <Grid x:Name="GridNav" Width="60">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Border 
                  Margin="14 0 0 0"
                  Width="35" Height="40"
                  HorizontalAlignment="Left">
                            <Border.Background>
                                <ImageBrush ImageSource="/Assets/cr_flag.png" Stretch="Uniform"/>
                            </Border.Background>
                        </Border>

                        <Viewbox Margin="60 0 0 0" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Label Content="FEL Costa Rica"
                               Foreground="{DynamicResource PrimaryTextColor}"
                               FontWeight="Bold"
                               FontSize="12"/>
                        </Viewbox>
                    </Grid>

                    <!-- Start: MenuItem -->
                    <StackPanel Grid.Row="1" Margin="-1 40 0 20">
                        <Button x:Name="btnHome" Style="{DynamicResource PopupButtonStyle}"  MouseEnter="btnHome_MouseEnter" MouseLeave="btnHome_MouseLeave" Click="btnHome_Click">
                            <ctls:MenuItem GroupName="MenuItem" IndicatorBrush="{DynamicResource PrimaryBlueColor}" Icon="{DynamicResource home}" IconWidth="16" Text="Inicio" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="btnMonitoring" Style="{DynamicResource PopupButtonStyle}"  MouseEnter="btnMonitoring_MouseEnter" MouseLeave="btnMonitoring_MouseLeave" Click="btnMonitoring_Click">
                            <ctls:MenuItem GroupName="MenuItem" IndicatorBrush="{DynamicResource PrimaryBlueColor}" Icon="{DynamicResource monitoring}" IconWidth="16" Text="Monitor" VerticalAlignment="Center"/>
                        </Button>
                        <!--<Button x:Name="btnDocuments" Style="{DynamicResource PopupButtonStyle}"  MouseEnter="btnDocuments_MouseEnter" MouseLeave="btnDocuments_MouseLeave" Click="btnDocuments_Click">
                            <ctls:MenuItem GroupName="MenuItem" IndicatorBrush="{DynamicResource PrimaryBlueColor}" Icon="{DynamicResource consult-documents}" IconWidth="16" Text="Consulta" VerticalAlignment="Center"/>
                        </Button>-->
                        <Button x:Name="btnCertifier" Style="{DynamicResource PopupButtonStyle}" MouseEnter="btnCertifier_MouseEnter" MouseLeave="btnCertifier_MouseLeave" Click="btnCertifier_Click">
                            <ctls:MenuItem GroupName="MenuItem" IndicatorBrush="{DynamicResource PrimaryBlueColor}" Icon="{DynamicResource certificate}" IconWidth="16" Text="Certificadores" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="btnCompany" Style="{DynamicResource PopupButtonStyle}"  MouseEnter="btnCompany_MouseEnter" MouseLeave="btnCompany_MouseLeave" Click="btnCompany_Click">
                            <ctls:MenuItem GroupName="MenuItem" IndicatorBrush="{DynamicResource PrimaryBlueColor}" Icon="{DynamicResource company}" IconWidth="16" Text="Empresa" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="btnSubsidiary" Style="{DynamicResource PopupButtonStyle}"  MouseEnter="btnSubsidiary_MouseEnter" MouseLeave="btnSubsidiary_MouseLeave" Click="btnSubsidiary_Click">
                            <ctls:MenuItem GroupName="MenuItem" IndicatorBrush="{DynamicResource PrimaryBlueColor}" Icon="{DynamicResource restore}" IconWidth="16" Text="Sucursal" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="btnRole" Style="{DynamicResource PopupButtonStyle}"  MouseEnter="btnRole_MouseEnter" MouseLeave="btnRole_MouseLeave" Click="btnRole_Click">
                            <ctls:MenuItem GroupName="MenuItem" IndicatorBrush="{DynamicResource PrimaryBlueColor}" Icon="{DynamicResource users}" IconWidth="16" Text="Roles" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="btnUsers" Style="{DynamicResource PopupButtonStyle}"  MouseEnter="btnUsers_MouseEnter" MouseLeave="btnUsers_MouseLeave" Click="btnUsers_Click">
                            <ctls:MenuItem GroupName="MenuItem" IndicatorBrush="{DynamicResource PrimaryBlueColor}" Icon="{DynamicResource user}" IconWidth="16" Text="Usuarios" VerticalAlignment="Center"/>
                        </Button>
                        <!--<Button x:Name="btnConsultDocuments" Style="{DynamicResource PopupButtonStyle}"  MouseEnter="btnConsultDocuments_MouseEnter" MouseLeave="btnConsultDocuments_MouseLeave" Click="btnConsultDocuments_Click">
                    <ctls:MenuItem GroupName="MenuItem" IndicatorBrush="{DynamicResource PrimaryBlueColor}" Icon="{DynamicResource consult-documents}" IconWidth="16" Text="Consulta Documentos" VerticalAlignment="Center"/>
                </Button>-->
                        <Button x:Name="btnLogs" Style="{DynamicResource PopupButtonStyle}"  MouseEnter="btnLogs_MouseEnter" MouseLeave="btnLogs_MouseLeave" Click="btnLogs_Click">
                            <ctls:MenuItem GroupName="MenuItem" IndicatorBrush="{DynamicResource PrimaryBlueColor}" Icon="{DynamicResource logs}" IconWidth="16" Text="Logs" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="btnSetting" Style="{DynamicResource PopupButtonStyle}"  MouseEnter="btnSetting_MouseEnter" MouseLeave="btnSetting_MouseLeave" Click="btnSetting_Click">
                            <ctls:MenuItem GroupName="MenuItem" IndicatorBrush="{DynamicResource PrimaryBlueColor}" Icon="{DynamicResource settings}" IconWidth="16" Text="Configuracion" VerticalAlignment="Center"/>
                        </Button>

                    </StackPanel>
                    <!-- End: MenuItem -->

                    <!-- Start: Popup User Control -->
                    <Popup x:Name="Popup"
                       AllowsTransparency="True"
                       HorizontalOffset="0"
                       VerticalOffset="10"
                       Placement="Right"
                       StaysOpen="True">
                        <ctls:UserPopup x:Name="Header"
                Foreground="{DynamicResource PrimaryTextColor}" />
                    </Popup>

                    <!-- End: Popup User Control -->

                    <!-- Start: LogOff Button-->
                    <Button Grid.Row="2"
                        x:Name="btnLogout"
                        Style="{DynamicResource PopupButtonStyle}"
                        Click="btnLogout_Click"
                        MouseEnter="btnLogout_MouseEnter"
                        MouseLeave="btnLogout_MouseLeave"
                        VerticalAlignment="Bottom"
                        Margin="0,10,0,10">
                        <ctls:MenuItem GroupName="MenuItem"
                                   IndicatorBrush="Crimson"
                                   Icon="{DynamicResource logout}"
                                   IconWidth="25"
                                   IconBrush="Crimson"
                                   Foreground="Crimson"
                                   Text="Cerrar Sesión"
                                   VerticalAlignment="Center"/>
                    </Button>
                    <!-- End: LogOff Button-->

                </Grid>
            </Border>

            <Grid Grid.Column="1" Grid.ColumnSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ToggleButton x:Name="Tg_Btn" Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource iToggleButtonStyle}" HorizontalAlignment="Left" BorderThickness="0" Background="Transparent" Margin="10,15,0,15" Height="30" Width="30">
                    <ToggleButton.Triggers>
                        <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                            <BeginStoryboard>
                                <Storyboard x:Name="HideStackPanel">
                                    <DoubleAnimation Storyboard.TargetName="GridNav" Storyboard.TargetProperty="Width" BeginTime="0:0:0" From="210" To="60" Duration="0:0:0.5">
                                    </DoubleAnimation>

                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="ToggleButton.Checked">
                            <BeginStoryboard>
                                <Storyboard x:Name="ShowStackPanel">
                                    <DoubleAnimation Storyboard.TargetName="GridNav" Storyboard.TargetProperty="Width" BeginTime="0:0:0" From="60" To="210" Duration="0:0:0.5">
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>

                        </EventTrigger>
                    </ToggleButton.Triggers>
                </ToggleButton>

                <!-- Start: Button Close | Restore | Minimize -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,10,0" Height="30" Orientation="Horizontal" FlowDirection="RightToLeft" Grid.RowSpan="2">
                    <Button x:Name="btnClose" Style="{StaticResource IconButtonsStyle}" Content="{DynamicResource close}" Click="btnClose_Click" Tag="IsCloseButton"/>
                    <Button x:Name="btnRestore" Margin="5,0" Click="btnRestore_Click">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource IconButtonsStyle}">
                                <Setter Property="Content" Value="{DynamicResource maximize}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=home, Path=WindowState}" Value="Maximized">
                                        <Setter Property="Content" Value="{DynamicResource restore}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="btnMinimize" Style="{DynamicResource IconButtonsStyle}" Content="{DynamicResource minimize}" Click="btnMinimize_Click"/>
                </StackPanel>
                <!-- End: Button Close | Restore | Minimize -->

                <Frame Grid.Row="1"
           Name="fContainer"
           Margin="10"
           NavigationUIVisibility="Hidden">

                </Frame>
                <Frame Grid.Row="1"
           Name="fContainerHome"
           Margin="10"
           NavigationUIVisibility="Hidden">

                </Frame>
                <Frame Grid.Row="1"
           Name="fContainerMonitor"
           Margin="10"
           NavigationUIVisibility="Hidden">

                </Frame>
            </Grid>



        </Grid>
    </Border>
</Window>
