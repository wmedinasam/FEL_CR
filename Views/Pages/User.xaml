<Page x:Class="FELRD.Views.Pages.User"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:local="clr-namespace:FELRD.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="800"
      TextElement.Foreground="{DynamicResource PrimaryTextColor}"
      Title="User">

    <Border CornerRadius="5" Background="{DynamicResource SecundaryBackgroundColor}">
        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.15*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Column="0" Grid.Row="0">
                <materialDesign:PackIcon Kind="User"  Margin="10 5 0 0" Width="50" Height="50" Foreground="{DynamicResource PrimaryTextColor}"/>
                <TextBlock Text="Usuarios del Sistema" Margin="70 20 0 0" FontSize="18" FontWeight="SemiBold" />
            </Grid>

            <!--START DATA ENTRY USER-->

            <Grid Grid.Column="0" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.17*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2.2*"/>
                    <!--ROW1-->
                    <RowDefinition Height="2.2*"/>
                    <!--ROW2-->
                    <RowDefinition Height="2.2*"/>
                    <!--ROW3-->
                    <RowDefinition Height="2.2*"/>
                    <!--ROW4-->
                    <RowDefinition Height="1.9*"/>
                    <!--ROW5-->
                    <RowDefinition Height="1.9*"/>
                    <!--ROW6-->
                    <RowDefinition Height="1.9*"/>
                    <!--ROW7-->
                </Grid.RowDefinitions>

                <materialDesign:PackIcon Kind="UserAdd"  Margin="5,0,0,20" 
                                 Width="30" Height="30"
                                 VerticalAlignment="Stretch"
                                 HorizontalAlignment="Stretch"
                                 Grid.Column="0" Grid.Row="0"
                                 Foreground="{DynamicResource PrimaryTextColor}"/>

                <TextBox 
            Text="{Binding Name, ValidatesOnExceptions=True, 
            UpdateSourceTrigger=PropertyChanged}"  
            x:Name="txtName" 
            VerticalAlignment="Stretch"
            MaxLength="100"
            Height="55"
            Margin="5.6,3,5,13.8"
            Grid.Column="1" Grid.Row="0"
            Background="{StaticResource PrimaryBackgroundColor}"
            materialDesign:HintAssist.Background="{DynamicResource SecundaryBackgroundColor}"
            FontSize="14" materialDesign:HintAssist.Hint="Ingrese Nombre" 
            BorderThickness="2" BorderBrush="{DynamicResource MaterialDesignDivider}" 
            Style="{StaticResource MaterialDesignOutlinedTextBox}"
            />

                <materialDesign:PackIcon Kind="Key"  Margin="5 0 0 5" 
                                 Width="30" Height="30"
                                 VerticalAlignment="Stretch"
                                 HorizontalAlignment="Stretch"
                                 Grid.Column="0" Grid.Row="1"
                                 Foreground="{DynamicResource PrimaryTextColor}"/>

                <TextBox 
            Text="{Binding Username, ValidatesOnExceptions=True, 
            UpdateSourceTrigger=PropertyChanged}"  
            x:Name="txtUsername" 
            VerticalAlignment="Stretch"
            MaxLength="100"
            Height="55"
            Margin="4.6,3.4,7,3.6"
            Grid.Column="1" Grid.Row="1"
            Background="{StaticResource PrimaryBackgroundColor}"
            FontSize="14" materialDesign:HintAssist.Hint="Ingrese Usuario" 
            materialDesign:HintAssist.Background="{DynamicResource SecundaryBackgroundColor}"
            BorderThickness="2" BorderBrush="{DynamicResource MaterialDesignDivider}" 
            Style="{StaticResource MaterialDesignOutlinedTextBox}"
            />

                <materialDesign:PackIcon Kind="Lock"  Margin="5 0 0 0" 
                                  Width="30" Height="30"
                                 VerticalAlignment="Stretch"
                                 HorizontalAlignment="Stretch"
                                 Grid.Column="0" Grid.Row="2"
                                 Foreground="{DynamicResource PrimaryTextColor}"/>

                <PasswordBox 
            x:Name="txtPassword" Width="160" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Stretch"
            Height="55"
            MaxLength="100"
            Margin="4.6,8.6,0,6.4"
            Grid.Column="1" Grid.Row="2"
            FontSize="14" 
            materialDesign:HintAssist.Hint="Contraseña" 
            materialDesign:HintAssist.HelperText="Ingrese la contraseña del usuario"
            materialDesign:HintAssist.HelperTextFontSize="9"
            Background="{StaticResource PrimaryBackgroundColor}"
            materialDesign:HintAssist.Background="{DynamicResource SecundaryBackgroundColor}"
            BorderThickness="2" BorderBrush="{DynamicResource MaterialDesignDivider}" 
            Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
            
            />
                <PasswordBox 
            x:Name="txtConfirmPassword" 
            VerticalAlignment="Stretch"
            MaxLength="100"
            Height="55"
            Margin="174.6,10.6,7,6.4"
            Grid.Column="1" Grid.Row="2"
            FontSize="14" 
            materialDesign:HintAssist.Hint="Confirmacion" 
            materialDesign:HintAssist.HelperText="Confirme la contraseña del usuario"
            materialDesign:HintAssist.HelperTextFontSize="9"
            Background="{StaticResource PrimaryBackgroundColor}"
            materialDesign:HintAssist.Background="{DynamicResource SecundaryBackgroundColor}"
            BorderThickness="2" BorderBrush="{DynamicResource MaterialDesignDivider}" 
            Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
            
            />

                <ComboBox x:Name="cbRoles" 
                      Grid.Column="1" 
                      Grid.Row="3"
                      Margin="5,10,10,10"
                      HorizontalContentAlignment="Center"
                      FontSize="14"
                      Background="{StaticResource PrimaryBackgroundColor}"
                      BorderThickness="2" 
                      BorderBrush="{DynamicResource MaterialDesignDivider}" 
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      Grid.ColumnSpan="2" 
                      VerticalAlignment="Stretch"
                      materialDesign:HintAssist.Hint="Seleccione Rol" 
                      materialDesign:HintAssist.Background="{DynamicResource SecundaryBackgroundColor}"/>


                <StackPanel Orientation="Horizontal" 
                    Grid.Row="4"
                    Grid.Column="1"
                    Margin="0,0,0,0" 
                    >
                    <StackPanel Orientation="Horizontal" 
                     Margin="30 0 0 0"
                    >
                        <ToggleButton x:Name="btnStatus" 
                      TextBlock.FontSize="20"
                      TextBlock.Foreground="{DynamicResource PrimaryTextColor}"
                      HorizontalAlignment="Left" 
                      VerticalAlignment="Stretch"
                      />
                        <TextBlock HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Text="Estado" FontSize="12" 
                   FontWeight="SemiBold"
                   Margin="5 0 0 0"
                   />
                    </StackPanel>
                </StackPanel>


                <Button Margin="0 0 5 25"
                HorizontalAlignment="Right"
                x:Name="btnAceptar"
                Padding="0"
                Style="{StaticResource MaterialDesignFlatMidBgButton}" 
                materialDesign:ShadowAssist.ShadowDepth="Depth0" 
                Height="40" 
                Width="100"
                VerticalAlignment="Stretch"
                Grid.Column="1" Grid.Row="7"
                materialDesign:ButtonAssist.CornerRadius="10" 
                FontSize="14" Click="btnAceptar_Click">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave"
                                 Width="20" Height="20"
                                 Foreground="{DynamicResource PrimaryTextColor}"/>

                            <TextBlock Text="Guardar" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </StackPanel>

                    </Button.Content>

                </Button>



            </Grid>

            <!--END DATA ENTRY USER-->

            <!--START DATAGRID USERS-->

            <Grid Grid.Column="1" Grid.Row="1">
                <DataGrid x:Name="grdUser"
                  Background="{DynamicResource PrimaryBackgroundColor}"
              Margin="10,5,10,10"
              CanUserAddRows="False" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns >
                        <DataGridTextColumn Header="Nombre" Binding="{Binding FullName}"/>
                        <DataGridCheckBoxColumn Header="Estatus"  Binding="{Binding UserStatus}"/>
                        <DataGridTemplateColumn Header="Acción">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button  BorderBrush="White" ToolTip="Editar Registro" BorderThickness="1" Cursor="Arrow" Width="30" Padding="0" Height="25" Click="Button_Click" >
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Edit" Height="18" Width="14"></materialDesign:PackIcon>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <Button x:Name="btnNew" 
            Grid.Column="1" 
            HorizontalAlignment="Left" 
            Margin="11,33,0,0" 
            Padding="0"
            VerticalAlignment="Top" Width="100" 
            Click="btnNew_Click">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="UserAdd"  Margin="0 0 5 0" 
                                 Width="25" Height="25"
                                 Foreground="{DynamicResource PrimaryTextColor}"/>

                        <TextBlock Text="Nuevo" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>

                </Button.Content>
            </Button>

            <!--END DATA GRID USERS-->

        </Grid>








    </Border>
</Page>
