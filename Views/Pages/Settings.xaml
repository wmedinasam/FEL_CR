<Page x:Class="FELRD.Views.Pages.Settings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FELRD.Views.Pages"
      mc:Ignorable="d" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      d:DesignHeight="550" d:DesignWidth="800"
      Title="Settings" Loaded="Page_Loaded">

    <Page.Resources>
        <!-- TextBox Estilo Limpio -->
        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="55"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryBackgroundColor}"/>
            <Setter Property="materialDesign:HintAssist.Background" Value="{DynamicResource PrimaryBackgroundColor}"/>
            <Setter Property="materialDesign:HintAssist.Foreground" Value="White"/>
            <Setter Property="materialDesign:HintAssist.FloatingScale" Value="1"/>
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="True"/>
        </Style>



        <!-- PasswordBox Estilo Limpio -->
        <Style TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignOutlinedPasswordBox}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="55" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{StaticResource PrimaryBackgroundColor}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />

            <!-- Hint -->
            <Setter Property="materialDesign:HintAssist.Foreground" Value="White" />
            <Setter Property="materialDesign:HintAssist.Background" Value="{x:Null}" />
            <Setter Property="materialDesign:HintAssist.FloatingScale" Value="1" />
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="True" />
        </Style>

    </Page.Resources>

    <Border CornerRadius="5" Background="{DynamicResource SecundaryBackgroundColor}">

        <StackPanel x:Name="mainPanel" Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
                <Grid>
                    <materialDesign:PackIcon Kind="Settings"  Margin="20 10 0 0" Width="50" Height="50" Foreground="{DynamicResource PrimaryTextColor}"/>
                    <TextBlock Text="Configuracion del Sistema" Margin="80 25 0 0" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                </Grid>
            </StackPanel>
            <Grid x:Name="principalGrid">

                <!--COLUMN GRID 1-->

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="0.25*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <materialDesign:PackIcon Kind="Database"  Margin="20 10 0 0" 
                                 Width="30" Height="30"
                                 VerticalAlignment="Stretch"
                                 HorizontalAlignment="Left"
                                 Grid.Column="0" Grid.Row="0"
                                 Foreground="{DynamicResource PrimaryTextColor}"/>

                <TextBox  
            x:Name="txtSQLUsername"
            HorizontalContentAlignment="Center"
            VerticalAlignment="Stretch"
            Height="55"
            MaxLength="50"
            Margin="60,10,6.4,0.2"
            Grid.Column="0" Grid.Row="0"
            materialDesign:HintAssist.Hint="Usuario SQL" 
            />

                <materialDesign:PackIcon Kind="Lock"  Margin="20 20 0 0" 
                                 Width="30" Height="30"
                                 VerticalAlignment="Stretch"
                                 HorizontalAlignment="Left"
                                 Grid.Column="0" Grid.Row="1"
                                 Foreground="{DynamicResource PrimaryTextColor}"/>

                <PasswordBox 
            x:Name="txtSQLPassword"
            HorizontalContentAlignment="Center"
            VerticalAlignment="Stretch"
            MaxLength="50"
            Height="55"
            Margin="60,20,6.4,73.2"
            Grid.Column="0" Grid.Row="1"
           materialDesign:HintAssist.Hint="Password SQL" 
 Grid.RowSpan="2"
            />

                <materialDesign:PackIcon Kind="Key"  Margin="20 20 0 0" 
                                 Width="30" Height="30"
                                 VerticalAlignment="Stretch"
                                 HorizontalAlignment="Left"
                                 Grid.Column="0" Grid.Row="2"
                                 Foreground="{DynamicResource PrimaryTextColor}"/>

                <PasswordBox   
            x:Name="txtMasterPassword"
            HorizontalContentAlignment="Center"
            VerticalAlignment="Stretch"
            MaxLength="50"
            Height="55"
            Margin="60,20.4,6.4,0.4"
            Grid.Column="0" Grid.Row="2"
            materialDesign:HintAssist.Hint="Master Password" 
           
            />

                <materialDesign:PackIcon Kind="Sync"  Margin="20 20 0 0" 
                                 Width="30" Height="30"
                                 VerticalAlignment="Stretch"
                                 HorizontalAlignment="Left"
                                 Grid.Column="0" Grid.Row="3"
                                 Foreground="{DynamicResource PrimaryTextColor}"/>

                <TextBlock x:Name="lblValue" Margin="100,59.6,10.4,72.4"
                   FontWeight="SemiBold"
                   Width="190"
                   HorizontalAlignment="Center"
                   Grid.Column="0" Grid.Row="3" Grid.RowSpan="2"
                           Foreground="White"
                       />

                <Slider x:Name="SyncTime"
                Margin="56,29.6,30.4,0.4" 
                Grid.Column="0" Grid.Row="3"
                Maximum="120"
                Minimum="5"  
                ToolTip="Tiempo de Sincronización"
                ValueChanged="SyncTime_ValueChanged"
                />

                <materialDesign:PackIcon Kind="KeyStar"  Margin="20 20 0 0" 
                                 Width="30" Height="30"
                                 VerticalAlignment="Stretch"
                                 HorizontalAlignment="Left"
                                 Grid.Column="0" Grid.Row="4"
                                 Foreground="{DynamicResource PrimaryTextColor}"/>

                <TextBox
            x:Name="txtSystemKey"
            Height="55"
            HorizontalContentAlignment="Center"
            VerticalAlignment="Stretch"
            Margin="60,19.6,6.4,0"
            Grid.Column="0" Grid.Row="4"
         materialDesign:HintAssist.Hint="Llave Sistema" 
            
            />

                <Button Margin="0,20,5,0" 
               x:Name="btnSaveConfig" 
               Style="{StaticResource MaterialDesignFlatMidBgButton}" 
               materialDesign:ShadowAssist.ShadowDepth="Depth0" 
               Height="45"
               Grid.Column="0" Grid.Row="5"
               materialDesign:ButtonAssist.CornerRadius="5" 
               FontSize="13" Click="btnSaveConfig_Click" HorizontalAlignment="Right" Width="120">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave"  Margin="0 3 5 0" 
                                Width="30" Height="30"
                                Foreground="{DynamicResource PrimaryTextColor}"/>

                            <TextBlock Text="Guardar" Height="18"
                              />
                        </StackPanel>

                    </Button.Content>

                </Button>

                <!-- END COLUMN 1-->

                <!--START COLUMN 2-->
                <materialDesign:PackIcon Kind="TextBox"  Margin="5 10 0 0" 
                                 Width="30" Height="30"
                                 VerticalAlignment="Stretch"
                                 HorizontalAlignment="Left"
                                 Grid.Column="1" Grid.Row="0"
                                 Foreground="{DynamicResource PrimaryTextColor}"/>

                <TextBox 
            x:Name="txtKey" 
            Height="55"
            HorizontalContentAlignment="Center"
            VerticalAlignment="Stretch"
            Margin="5,10,5,0"
            Grid.Column="2" Grid.Row="0"
           materialDesign:HintAssist.Hint="Llave" 
           
            />
                <TextBox 
            x:Name="txtValue" 
            Height="55"
            HorizontalContentAlignment="Center"
            VerticalAlignment="Stretch"
            Margin="5,10,5,0"
            Grid.Column="3" Grid.Row="0"
            materialDesign:HintAssist.Hint="Valor" 
            
            />

                <TextBox 
            x:Name="txtDescription" 
            Height="55"
            HorizontalContentAlignment="Center"
            VerticalAlignment="Stretch"
            Margin="5,10,15,0"
            Grid.Column="4" Grid.Row="0"
            materialDesign:HintAssist.Hint="Descripcion" 
           
            />

                <!--<materialDesign:PackIcon Kind="Api"  Margin="0 10 0 0" 
                                 Width="30" Height="30"
                                 VerticalAlignment="Stretch"
                                 HorizontalAlignment="Left"
                                 Grid.Column="1" Grid.Row="1"
                                 Foreground="{DynamicResource PrimaryTextColor}"/>

        <TextBox  
            x:Name="txtSendXML"
            Height="55"
            HorizontalContentAlignment="Center"
            VerticalAlignment="Stretch"
            Margin="34.6,9.8,10,73.4"
            Grid.Column="1" Grid.Row="1"
            Background="{StaticResource PrimaryBackgroundColor}"
             materialDesign:HintAssist.Background="{DynamicResource SecundaryBackgroundColor}"
            FontSize="14" materialDesign:HintAssist.Hint="API Send XML" 
            BorderThickness="2" BorderBrush="{DynamicResource MaterialDesignDivider}" 
            Style="{StaticResource MaterialDesignOutlinedTextBox}" Grid.RowSpan="2"
            />

        <materialDesign:PackIcon Kind="Api"  Margin="0 10 0 0" 
                                 Width="30" Height="30"
                                 VerticalAlignment="Stretch"
                                 HorizontalAlignment="Left"
                                 Grid.Column="1" Grid.Row="2"
                                 Foreground="{DynamicResource PrimaryTextColor}"/>

        <TextBox 
            x:Name="txtConsultaHacienda"
            Height="55"
            HorizontalContentAlignment="Center"
            VerticalAlignment="Stretch"
            Margin="34.6,10.2,10,0.4"
            Grid.Column="1" Grid.Row="2"
            Background="{StaticResource PrimaryBackgroundColor}"
             materialDesign:HintAssist.Background="{DynamicResource SecundaryBackgroundColor}"
            FontSize="14" materialDesign:HintAssist.Hint="API Consulta Hacienda" 
            BorderThickness="2" BorderBrush="{DynamicResource MaterialDesignDivider}" 
            Style="{StaticResource MaterialDesignOutlinedTextBox}"
            />

        <materialDesign:PackIcon Kind="Api"  Margin="0 10 0 0" 
                                 Width="30" Height="30"
                                 VerticalAlignment="Stretch"
                                 HorizontalAlignment="Left"
                                 Grid.Column="1" Grid.Row="3"
                                 Foreground="{DynamicResource PrimaryTextColor}"/>

        <TextBox 
            x:Name="txtConsultaDocumento"
            Height="55"
            HorizontalContentAlignment="Center"
            VerticalAlignment="Stretch"
            Margin="34.6,9.6,10,0.4"
            Grid.Column="1" Grid.Row="3"
            Background="{StaticResource PrimaryBackgroundColor}"
             materialDesign:HintAssist.Background="{DynamicResource SecundaryBackgroundColor}"
            FontSize="14" materialDesign:HintAssist.Hint="API Consulta Documento" 
            BorderThickness="2" BorderBrush="{DynamicResource MaterialDesignDivider}" 
            Style="{StaticResource MaterialDesignOutlinedTextBox}"
            />

        <materialDesign:PackIcon Kind="Api"  Margin="0 10 0 0" 
                                 Width="30" Height="30"
                                 VerticalAlignment="Stretch"
                                 HorizontalAlignment="Left"
                                 Grid.Column="1" Grid.Row="4"
                                 Foreground="{DynamicResource PrimaryTextColor}"/>

        <TextBox 
            x:Name="txtCheckDocument"
            Height="55"
            HorizontalContentAlignment="Center"
            VerticalAlignment="Stretch"
            Margin="34.6,9.6,10,0"
            Grid.Column="1" Grid.Row="4"
            Background="{StaticResource PrimaryBackgroundColor}"
             materialDesign:HintAssist.Background="{DynamicResource SecundaryBackgroundColor}"
            FontSize="14" materialDesign:HintAssist.Hint="API Check Document" 
            BorderThickness="2" BorderBrush="{DynamicResource MaterialDesignDivider}" 
            Style="{StaticResource MaterialDesignOutlinedTextBox}"
            />

        <materialDesign:PackIcon Kind="Api"  Margin="0 10 0 0" 
                                 Width="30" Height="30"
                                 VerticalAlignment="Stretch"
                                 HorizontalAlignment="Left"
                                 Grid.Column="1" Grid.Row="5"
                                 Foreground="{DynamicResource PrimaryTextColor}"/>

        <TextBox 
            x:Name="txtReenvioDocumento"
            Height="55"
            HorizontalContentAlignment="Center"
            VerticalAlignment="Stretch"
            Margin="34.6,10,10,49.4"
            Grid.Column="1" Grid.Row="5"
            Background="{StaticResource PrimaryBackgroundColor}"
             materialDesign:HintAssist.Background="{DynamicResource SecundaryBackgroundColor}"
            FontSize="14" materialDesign:HintAssist.Hint="API Reenvio Documento" 
            BorderThickness="2" BorderBrush="{DynamicResource MaterialDesignDivider}" 
            Style="{StaticResource MaterialDesignOutlinedTextBox}" Grid.RowSpan="2"
            />-->
                <Button Margin="123,16,0,16" 
               Padding="0"
               x:Name="btnNewConfig" 
               Style="{StaticResource MaterialDesignFlatMidBgButton}" 
               Background="DarkOrange"
               materialDesign:ShadowAssist.ShadowDepth="Depth0" 
               Height="40" Width="100"
               HorizontalAlignment="Left"
               Grid.Column="3" Grid.Row="1"
               materialDesign:ButtonAssist.CornerRadius="5" 
               FontSize="14"
               Click="btnNewConfig_Click" Grid.ColumnSpan="2">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CodeJson"  Margin="0 0 1 0" 
                                Width="20" Height="20"
                                Foreground="{DynamicResource PrimaryTextColor}"/>

                            <TextBlock Text="Nuevo"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              />
                        </StackPanel>

                    </Button.Content>

                </Button>
                <Button Margin="0,16,0,16" 
               Padding="0"
               x:Name="btnSaveApi" 
               Style="{StaticResource MaterialDesignFlatMidBgButton}" 
               materialDesign:ShadowAssist.ShadowDepth="Depth0" 
               Height="40" Width="100"
               HorizontalAlignment="Center"
               Grid.Column="4" Grid.Row="1"
               materialDesign:ButtonAssist.CornerRadius="5" 
               FontSize="14"
               Click="btnSaveApi_Click">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Add"  Margin="0 0 1 0" 
                                Width="20" Height="20"
                                Foreground="{DynamicResource PrimaryTextColor}"/>

                            <TextBlock Text="Agregar"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              />
                        </StackPanel>

                    </Button.Content>

                </Button>


                <!--DATAGRID VALUES-->
                <Grid Grid.Column="2" Grid.Row="2" Grid.ColumnSpan="3" Grid.RowSpan="6" Margin="5">
                    <DataGrid x:Name="grdSettings"
                  Background="{DynamicResource PrimaryBackgroundColor}"
              Margin="5,5,10,5"
              CanUserAddRows="False" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns >
                            <DataGridTextColumn Header="Llave" Binding="{Binding Key}"/>
                            <DataGridTextColumn Header="Valor" Binding="{Binding Value}"/>
                            <DataGridTextColumn Header="Descripcion" Binding="{Binding Description}"/>
                            <DataGridTemplateColumn Header="Acción">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button  BorderBrush="White" ToolTip="Editar Registro" BorderThickness="1" Cursor="Arrow" Width="30" Padding="0" Height="25" Click="Button_Click" >
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Edit" Height="18" Width="14"></materialDesign:PackIcon>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
                <!--END DATAGRID VALUES-->


            </Grid>
        </StackPanel>

    </Border>
</Page>
