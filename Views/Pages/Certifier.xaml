<Page x:Class="FELRD.Views.Pages.Certifier"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FELRD.Views.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="768" d:DesignWidth="1024"
      TextElement.Foreground="{DynamicResource PrimaryTextColor}"
      Title="Certifier">

    <Border CornerRadius="5" Background="{DynamicResource SecundaryBackgroundColor}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <Grid Grid.Row="0">
                <materialDesign:PackIcon Kind="Certificate"  Margin="20 10 0 0" Width="50" Height="50" Foreground="{DynamicResource PrimaryTextColor}"/>
                <TextBlock Text="Certificadores FEL" Margin="80 25 0 0" FontSize="18" FontWeight="SemiBold" Foreground="White" />
            </Grid>

            <!-- Cuerpo principal -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*"/>
                    <ColumnDefinition Width="1.1*"/>
                </Grid.ColumnDefinitions>

                <!-- FORMULARIO -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Column="0">
                    <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.15*"/>
                            <ColumnDefinition Width="0.85*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <materialDesign:PackIcon Kind="UserAdd" Margin="30,20" Width="30" Height="30" Grid.Column="0" Grid.Row="0" Foreground="{DynamicResource PrimaryIconColor}"/>
                        <TextBox x:Name="txtName" Grid.Column="1" Grid.Row="0" Margin="5,5"
                                 Style="{StaticResource CleanOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Ingrese Nombre" MaxLength="50"/>

                        <materialDesign:PackIcon Kind="Web" Margin="30 20" Width="30" Height="30" Grid.Column="0" Grid.Row="1" Foreground="{DynamicResource PrimaryIconColor}"/>
                        <TextBox x:Name="txtEndPoint" Grid.Column="1" Grid.Row="1" Margin="5,5"
                                 Style="{StaticResource CleanOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Ingrese EndPoint" MaxLength="100"/>

                        <materialDesign:PackIcon Kind="User" Margin="30 20" Width="30" Height="30" Grid.Column="0" Grid.Row="2" Foreground="{DynamicResource PrimaryIconColor}"/>
                        <TextBox x:Name="txtCommercialName" Grid.Column="1" Grid.Row="2" Margin="5,5"
                                 Style="{StaticResource CleanOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Ingrese Nombre Comercial" MaxLength="100"/>

                        <materialDesign:PackIcon Kind="FileDocument" Margin="30 20" Width="30" Height="30" Grid.Column="0" Grid.Row="3" Foreground="{DynamicResource PrimaryIconColor}"/>
                        <TextBox x:Name="txtNit" Grid.Column="1" Grid.Row="3" Margin="5,5"
                                 Style="{StaticResource CleanOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Ingrese Nit" MaxLength="100"/>

                        <materialDesign:PackIcon Kind="User" Margin="30 20" Width="30" Height="30" Grid.Column="0" Grid.Row="4" Foreground="{DynamicResource PrimaryIconColor}"/>
                        <TextBox x:Name="txtUsuarioWS" Grid.Column="1" Grid.Row="4" Margin="5,5"
                                 Style="{StaticResource CleanOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Ingrese Usuario" MaxLength="100"/>

                        <materialDesign:PackIcon Kind="Password" Margin="30 20" Width="30" Height="30" Grid.Column="0" Grid.Row="5" Foreground="{DynamicResource PrimaryIconColor}"/>
                        <TextBox x:Name="txtPasswordWS" Grid.Column="1" Grid.Row="5" Margin="5,5"
                                 Style="{StaticResource CleanOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Ingrese Contraseña" MaxLength="100"/>

                        <materialDesign:PackIcon Kind="Security" Margin="30 20" Width="30" Height="30" Grid.Column="0" Grid.Row="6" Foreground="{DynamicResource PrimaryIconColor}"/>
                        <TextBox x:Name="txtSecurityKey" Grid.Column="1" Grid.Row="6" Margin="5,5"
                                 Style="{StaticResource CleanOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Ingrese Llave" MaxLength="100"/>

                        <Button x:Name="btnSave" Grid.Column="1" Grid.Row="7" Margin="5,30"
                                Content="Guardar" Width="250"
                                Style="{StaticResource SaveButtonStyle}"
                                Click="btnAceptar_Click"/>
                    </Grid>
                </ScrollViewer>

                <!-- DATAGRID -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="btnNew" Grid.Row="0" Margin="5,10" Width="150"
                            Content="Nuevo" Style="{StaticResource NewButtonStyle}"
                            Click="btnNew_Click" HorizontalAlignment="Left"/>

                    <DataGrid x:Name="grdCertifier" Grid.Row="1" Margin="5,10"
                              Background="{DynamicResource PrimaryBackgroundColor}"
                              CanUserAddRows="False" AutoGenerateColumns="False" IsReadOnly="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Name}"/>
                            <DataGridTemplateColumn Header="Acción">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button ToolTip="Editar Registro" Width="30" Height="25" Padding="0" Click="Button_Click">
                                                <materialDesign:PackIcon Kind="Edit" Height="18" Width="14"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Page>