<Page x:Class="FELRD.Views.Pages.Certifier"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FELRD.Views.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="800"
      TextElement.Foreground="{DynamicResource PrimaryTextColor}"
      Title="Certifier">

    <Border CornerRadius="5" Background="{DynamicResource SecundaryBackgroundColor}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.15*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Column="0" Grid.Row="0">
                <materialDesign:PackIcon Kind="Certificate"  Margin="10 5 0 0" Width="50" Height="50" Foreground="{DynamicResource PrimaryTextColor}"/>
                <TextBlock Text="Certificadores" Margin="70 20 0 0" FontSize="18" FontWeight="SemiBold" Foreground="White" />
            </Grid>

            <!--START DATA ENTRY USER-->

            <Grid Grid.Column="0" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.17*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2.2*"/>
                    <!--ROW1-->
                    <RowDefinition Height="2.2*"/>
                    <!--ROW2-->
                    <RowDefinition Height="2.2*"/>
                    <!--ROW3-->
                    <RowDefinition Height="2.2*"/>
                    <!--ROW4-->
                    <RowDefinition Height="2.2*"/>
                    <!--ROW5-->
                    <RowDefinition Height="2.2*"/>
                    <!--ROW6-->
                    <RowDefinition Height="2.2*"/>

                </Grid.RowDefinitions>

                <materialDesign:PackIcon Kind="UserAdd"  Margin="5,0,0,20" 
                                 Width="30" Height="30"
                                 VerticalAlignment="Stretch"
                                 HorizontalAlignment="Stretch"
                                 Grid.Column="0" Grid.Row="0"
                                 Foreground="{DynamicResource PrimaryTextColor}"/>

                <TextBox 
            Text="{Binding Name, ValidatesOnExceptions=True, 
            UpdateSourceTrigger=PropertyChanged}"  
            x:Name="txtName" 
            VerticalAlignment="Stretch"
            MaxLength="50"
            Height="45"
            Margin="5,0,3,10"
            Grid.Column="1" Grid.Row="0"
            Background="{StaticResource PrimaryBackgroundColor}"
            materialDesign:HintAssist.Background="{DynamicResource SecundaryBackgroundColor}"
            FontSize="8" materialDesign:HintAssist.Hint="Ingrese Nombre" 
            BorderThickness="2" BorderBrush="{DynamicResource MaterialDesignDivider}" 
            Style="{StaticResource MaterialDesignOutlinedTextBox}" Foreground="White"
            />

                <materialDesign:PackIcon Kind="Web"  Margin="5 0 0 5" 
                                 Width="30" Height="30"
                                 VerticalAlignment="Stretch"
                                 HorizontalAlignment="Stretch"
                                 Grid.Column="0" Grid.Row="1"
                                 Foreground="{DynamicResource PrimaryTextColor}"/>

                <TextBox 
            Text="{Binding EndPointToken, ValidatesOnExceptions=True, 
            UpdateSourceTrigger=PropertyChanged}"  
            x:Name="txtEndPoint" 
            VerticalAlignment="Stretch"
            MaxLength="100"
            Height="45"
            Margin="5,0,3,10"
            Grid.Column="1" Grid.Row="1"
            Background="{StaticResource PrimaryBackgroundColor}"
            FontSize="8" materialDesign:HintAssist.Hint="Ingrese EndPoint" 
            materialDesign:HintAssist.Background="{DynamicResource SecundaryBackgroundColor}"
            BorderThickness="2" BorderBrush="{DynamicResource MaterialDesignDivider}" 
            Style="{StaticResource MaterialDesignOutlinedTextBox}" Foreground="White"
            />

                <materialDesign:PackIcon Kind="User"  Margin="5 0 0 0" 
                                  Width="30" Height="30"
                                 VerticalAlignment="Stretch"
                                 HorizontalAlignment="Stretch"
                                 Grid.Column="0" Grid.Row="2"
                                 Foreground="{DynamicResource PrimaryTextColor}"/>
                <TextBox 
            Text="{Binding CommercialName, ValidatesOnExceptions=True, 
            UpdateSourceTrigger=PropertyChanged}"  
            x:Name="txtCommercialName" 
            VerticalAlignment="Stretch"
            MaxLength="100"
            Height="45"
            Margin="5,0,3,10"
            Grid.Column="1" Grid.Row="2"
            Background="{StaticResource PrimaryBackgroundColor}"
            materialDesign:HintAssist.Background="{DynamicResource SecundaryBackgroundColor}"
            FontSize="8" materialDesign:HintAssist.Hint="Ingrese Nombre Comercial" 
            BorderThickness="2" BorderBrush="{DynamicResource MaterialDesignDivider}" 
            Style="{StaticResource MaterialDesignOutlinedTextBox}" Foreground="White"
            />

                <materialDesign:PackIcon Kind="FileDocument"  Margin="5 0 0 0" 
                                  Width="30" Height="30"
                                 VerticalAlignment="Stretch"
                                 HorizontalAlignment="Stretch"
                                 Grid.Column="0" Grid.Row="3"
                                 Foreground="{DynamicResource PrimaryTextColor}"/>

                <TextBox 
            Text="{Binding Nit, ValidatesOnExceptions=True, 
            UpdateSourceTrigger=PropertyChanged}"  
            x:Name="txtNit" 
            VerticalAlignment="Stretch"
            MaxLength="100"
            Height="45"
            Margin="5,0,3,10"
            Grid.Column="1" Grid.Row="3"
            Background="{StaticResource PrimaryBackgroundColor}"
            materialDesign:HintAssist.Background="{DynamicResource SecundaryBackgroundColor}"
            FontSize="8" materialDesign:HintAssist.Hint="Ingrese Nit" 
            BorderThickness="2" BorderBrush="{DynamicResource MaterialDesignDivider}" 
            Style="{StaticResource MaterialDesignOutlinedTextBox}" Foreground="White"
            />

                <materialDesign:PackIcon Kind="User"  Margin="5 0 0 0" 
                  Width="30" Height="30"
                 VerticalAlignment="Stretch"
                 HorizontalAlignment="Stretch"
                 Grid.Column="0" Grid.Row="4"
                 Foreground="{DynamicResource PrimaryTextColor}"/>

                <TextBox 
                Text="{Binding UsuarioWS, ValidatesOnExceptions=True, 
                UpdateSourceTrigger=PropertyChanged}"  
                x:Name="txtUsuarioWS"
                MaxLength="100"
                Height="45"
                Grid.Column="1" Grid.Row="4"
                Background="{StaticResource PrimaryBackgroundColor}"
                materialDesign:HintAssist.Background="{DynamicResource SecundaryBackgroundColor}"
                FontSize="8" materialDesign:HintAssist.Hint="Ingrese Usuario" 
                BorderThickness="2" BorderBrush="{DynamicResource MaterialDesignDivider}"  Foreground="White"
                Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="5,12,0,23" HorizontalAlignment="Left" Width="306"
/>

                <materialDesign:PackIcon Kind="Password"  Margin="5 0 0 0" 
                  Width="30" Height="30"
                 VerticalAlignment="Stretch"
                 HorizontalAlignment="Stretch"
                 Grid.Column="0" Grid.Row="5"
                 Foreground="{DynamicResource PrimaryTextColor}"/>
                
                <TextBox 
                Text="{Binding PasswordWS, ValidatesOnExceptions=True, 
                UpdateSourceTrigger=PropertyChanged}"  
                x:Name="txtPasswordWS"
                MaxLength="100"
                Height="45"
                Margin="5,12,0,22"
                Grid.Column="1" Grid.Row="5"
                Background="{StaticResource PrimaryBackgroundColor}"
                materialDesign:HintAssist.Background="{DynamicResource SecundaryBackgroundColor}"
                FontSize="8" materialDesign:HintAssist.Hint="Ingrese Contraseña" 
                BorderThickness="2" BorderBrush="{DynamicResource MaterialDesignDivider}"  Foreground="White"
                Style="{StaticResource MaterialDesignOutlinedTextBox}" HorizontalAlignment="Left" Width="303"

                />

                <materialDesign:PackIcon Kind="Security"  Margin="5 0 0 0" 
  Width="30" Height="30"
 VerticalAlignment="Stretch"
 HorizontalAlignment="Stretch"
 Grid.Column="0" Grid.Row="6"
 Foreground="{DynamicResource PrimaryTextColor}"/>

                <TextBox 
Text="{Binding PasswordWS, ValidatesOnExceptions=True, 
UpdateSourceTrigger=PropertyChanged}"  
x:Name="txtSecurityKey"
MaxLength="100"
Height="45"
Margin="5,12,0,22"
Grid.Column="1" Grid.Row="6"
Background="{StaticResource PrimaryBackgroundColor}"
materialDesign:HintAssist.Background="{DynamicResource SecundaryBackgroundColor}"
FontSize="8" materialDesign:HintAssist.Hint="Ingrese Llave" 
BorderThickness="2" BorderBrush="{DynamicResource MaterialDesignDivider}"  Foreground="White"
Style="{StaticResource MaterialDesignOutlinedTextBox}" HorizontalAlignment="Left" Width="303"

/>

            </Grid>

            <!--END DATA ENTRY CERTIFIER-->

            <!--START DATAGRID CERTIFIER-->

            <Grid Grid.Column="1" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.5*"/>
                    <!--ROW1-->
                    <RowDefinition Height="0.3*"/>
                    <!--ROW2-->
                    
                    



                </Grid.RowDefinitions>

                <Button x:Name="btnSave" 
            Grid.Column="0" 
            Grid.Row="0"
            HorizontalAlignment="Left" 
            Margin="120,15,0,0" 
            Padding="0"
            VerticalAlignment="Top" Width="100" 
            Click="btnAceptar_Click">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave"  Margin="0 0 5 0" 
                                 Width="25" Height="25"
                                 Foreground="{DynamicResource PrimaryTextColor}"/>

                            <TextBlock Text="Guardar" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </StackPanel>

                    </Button.Content>
                </Button>


                <Button x:Name="btnNew" 
            Grid.Column="1" 
            Grid.Row="0"
            HorizontalAlignment="Left" 
            Margin="11,15,0,0" 
            Padding="0"
            VerticalAlignment="Top" Width="100" 
            Click="btnNew_Click">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="UserAdd"  Margin="0 0 5 0" 
                                 Width="25" Height="25"
                                 Foreground="{DynamicResource PrimaryTextColor}"/>

                            <TextBlock Text="Nuevo" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </StackPanel>

                    </Button.Content>
                </Button>





                <Grid Grid.Column="0" Margin="0,52,0,0" Grid.RowSpan="2">
                    <DataGrid x:Name="grdCertifier"
                  Background="{DynamicResource PrimaryBackgroundColor}"
              Margin="10,5,10,10"
              CanUserAddRows="False" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns >
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Name}"/>
                            <DataGridTemplateColumn Header="Acción">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button  BorderBrush="White" ToolTip="Editar Registro" BorderThickness="1" Cursor="Arrow" Width="30" Padding="0" Height="25" Click="Button_Click" >
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Edit" Height="18" Width="14"></materialDesign:PackIcon>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Grid>
        <!--END DATA GRID CERTIFIER-->

    </Border>
</Page>
