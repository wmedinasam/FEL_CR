<Page x:Class="FELRD.Views.Pages.Monitor"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:local="clr-namespace:FELRD.Views.Pages"
      xmlns:helpers="clr-namespace:FELRD.Helpers"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Monitor" Loaded="Page_Loaded"
      TextElement.Foreground="{DynamicResource MaterialDesignBody}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <helpers:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <CircleEase x:Key="CircleEaseOut" EasingMode="EaseOut" />
    </Page.Resources>

    <Border CornerRadius="5" Background="{DynamicResource SecundaryBackgroundColor}">
        <Grid>

            <TextBlock Text="Monitoreo de Documentos" FontSize="25"
                   FontWeight="SemiBold"
                   Margin="10 10 0 0"
                   HorizontalAlignment="Left"
                       Foreground="{DynamicResource PrimaryTextColor}"
                   />
            <StackPanel Orientation="Vertical"  VerticalAlignment="Top" Margin="10" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Text="Iniciar Monitor" FontSize="20" 
                                Foreground="{DynamicResource PrimaryTextColor}"
                   Style="{DynamicResource MaterialDesignBody1TextBlock}"
                   FontWeight="SemiBold"
                   Margin="0 0 15 0"
                   />
                    <ToggleButton x:Name="btnIniciar"
                        HorizontalAlignment="Right"
                        TextBlock.FontSize="25"
                        TextBlock.Foreground="{DynamicResource PrimaryTextColor}"
                          Click="btnIniciar_Click"
                          
                        />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock HorizontalAlignment="Right"
                                Foreground="{DynamicResource PrimaryTextColor}"
                   VerticalAlignment="Center"
                   Text="Estado:" FontSize="20" 
                   Style="{DynamicResource MaterialDesignBody1TextBlock}"
                   FontWeight="SemiBold"
                   Margin="0 0 15 0"
                   />
                    <materialDesign:Card x:Name="cardEstado"
                     UniformCornerRadius="10"
                     Padding="6 3"
                     Width="180" Height="40"
                     Background="{Binding CardColor}" 
                     Margin="0"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Right"
                     materialDesign:ShadowAssist.ShadowDepth="Depth1">
                        <StackPanel Orientation="Horizontal"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

                            <!-- Ícono o Spinner -->
                            <Grid Width="22" Height="22">
                                <!-- Ícono de estado -->
                                <materialDesign:PackIcon x:Name="iconState"
                                     Width="22" Height="22"
                                     Kind="{Binding IconType}"
                                     Foreground="{Binding IconColor}"
                                     Visibility="{Binding IsLoading, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                                <!-- Spinner animado -->
                                <Canvas Width="22" Height="22"
                                    Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">

                                    <!-- Fondo circular tenue -->
                                    <Ellipse Width="22" Height="22"
                                         Stroke="{DynamicResource PrimaryHueMidBrush}"
                                         StrokeThickness="2"
                                         Opacity="0.2" />

                                    <!-- Arco giratorio más visible -->
                                    <Path Stroke="{DynamicResource PrimaryHueMidBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M11,1 A10,10 0 1 1 11,21"
                                      RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform x:Name="SpinnerRotate" />
                                        </Path.RenderTransform>
                                        <Path.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation
                                                        Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                                        From="0" To="360"
                                                        Duration="0:0:0.8"
                                                        RepeatBehavior="Forever"
                                                        EasingFunction="{StaticResource CircleEaseOut}" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Path.Triggers>
                                    </Path>
                                </Canvas>
                            </Grid>

                            <!-- Texto del estado -->
                            <TextBlock x:Name="txtState"
                   Text="{Binding StateText}"
                   Foreground="{Binding TextColor}"
                   FontSize="13"
                   Margin="6,0,0,0"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold" />
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
            Margin="10,60,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">
                <TextBlock Text="Última Actualización:"
                           FontSize="13"
                           Foreground="#FFB0B0B0"
                           FontWeight="Normal"
                           Margin="0,5,0,0" />

                <TextBlock x:Name="txtLastUpdated" Text="{Binding LastUpdated}"
                       FontSize="13"
                       Foreground="#FFB0B0B0"
                       FontWeight="Bold"
                       Margin="5,5,0,0" />
            </StackPanel>

            <!--BEGIN DATA GRIDS-->



            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!--DATAGRID DOCUMENTS SUCCESS-->
                <DataGrid x:Name="dgvSuccess" Margin="10,90,2.5,9.6"  
                      Grid.Column="0" Grid.Row="0"
                      Background="{DynamicResource PrimaryBackgroundColor}" 
                      CanUserAddRows="False"
                      CanUserSortColumns="True"
                      AutoGenerateColumns="False"
                      ItemsSource="{Binding TransactionsSuccess}"
                      >
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Command="Copy"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Foreground="#fff" Header="Empresa" Binding="{Binding Company.Name}"  />
                        <DataGridTextColumn Foreground="#fff" Header="Docto" Binding="{Binding SAEDocumentId}"  />
                        <DataGridTextColumn Foreground="#fff" Header="Tipo" Binding="{Binding DocumentType}" />
                        <DataGridTextColumn Foreground="#fff" Header="UUID" Binding="{Binding UUID}" />
                        <DataGridTemplateColumn Header="Accion">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button 
                                            x:Name="btnConsultar" 
                                            Content="{materialDesign:PackIcon Kind=FilePdf, Size=20}"  
                                            ToolTip="Visualizar PDF"  
                                            Foreground="#74D5FA" 
                                            Background="#030E18"  
                                            BorderThickness="1" 
                                            Cursor="Arrow" 
                                            Width="30" 
                                            Height="25" 
                                            HorizontalAlignment="Center" 
                                            Padding="1,1,1,2"  
                                            CommandParameter="{Binding UUID}" 
                                            Visibility="{Binding btnPDF}" 
                                            Click="btnConsultar_Click">
                                    </Button>
                                    <Grid Width="10"></Grid>
                                        <Button x:Name="btnAnular"
                                                Foreground="#FAB3AE"
                                                Background="#180605"
                                                BorderBrush="#f44336"
                                                ToolTip="Anular Documento"
                                                BorderThickness="1"
                                                Cursor="Arrow"
                                                Height="25"
                                                Padding="5,0"
                                                Width="95"
                                                HorizontalAlignment="Center"                                                
                                                Click="btnAnular_Click"
                                                Visibility="Hidden"
                                                >
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <materialDesign:PackIcon Kind="BlockHelper" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <TextBlock Text="Anular" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <!--DATAGRID DOCUMENTS REFUSED-->
                <DataGrid x:Name="grdRejected" Margin="2.5,90,10,10"  
                      Grid.Column="1" Grid.Row="0"
                  AutoGenerateColumns="False"
                      CanUserSortColumns="True"
                      Background="{DynamicResource PrimaryBackgroundColor}"
                      IsReadOnly="True"
                      ItemsSource="{Binding TransactionsRejected}"    >
                    <DataGrid.Columns>
                        <DataGridTextColumn Foreground="#fff" Header="Empresa" Binding="{Binding Company.Name}"  />
                        <DataGridTextColumn Foreground="#fff" Header="Docto" Binding="{Binding SAEDocumentId}"  />
                        <DataGridTextColumn Foreground="#fff" Header="Tipo" Binding="{Binding DocumentType}" />
                        <DataGridTemplateColumn Header="Accion" CanUserResize="False" >
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" >
                                        <Button x:Name="btnRetry" Content="{materialDesign:PackIcon Kind=Restart, Size=19}"  ToolTip="Reprocesar Transaccion" Foreground="#B7DFB9" Background="#071107"   BorderThickness="1"  Cursor="Arrow" Padding="0" Height="25" Width="30" Click="btnRetry_Click">
                                        </Button>
                                        <Grid Width="10"></Grid>
                                        <Button x:Name="btnError" ToolTip="Ver Error" Foreground="#FAB3AE" Background="#180605"  BorderThickness="1" Cursor="Arrow"  Height="25" Width="70"  HorizontalAlignment="Center" Padding="1,1,1,2" Click="btnError_Click" >
                                            <Button.Content>

                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="BugCheckOutline" Width="20" Height="20" />
                                                    <Label x:Name="lblShowError" Content="Error" Padding="0" Margin="6,0" Foreground="#FAB3AE"  FontSize="14" />
                                                </StackPanel>

                                            </Button.Content>
                                        </Button>
                                        <Grid Width="10"></Grid>

                                        <Button x:Name="btnDescartar"   ToolTip="Descartar Transaccion" Background="#FF190F00" BorderBrush="White" Foreground="#DDFFD599"  BorderThickness="1"  Cursor="Arrow" Padding="2" Height="25" Width="100" Click="btnDescartar_Click">
                                            <Button.Content>

                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="FileCancel" Width="20" Height="20" />
                                                    <Label x:Name="lblDescartar" Content="Descartar" Padding="0" Margin="6,0" Foreground="#DDFFD599"  FontSize="14" />
                                                </StackPanel>

                                            </Button.Content>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>

                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>


            </Grid>
            <!--END DATA GRIDS-->
        </Grid>
    </Border>

</Page>
