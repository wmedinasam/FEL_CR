<Page x:Class="FELRD.Views.Pages.Documents"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:local="clr-namespace:FELRD.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="768" d:DesignWidth="1024"
      TextElement.Foreground="{DynamicResource PrimaryTextColor}"
      Title="Documents">


    <Border CornerRadius="5" Background="{DynamicResource SecundaryBackgroundColor}">
        <Grid Margin="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Título -->
            <Grid Grid.Row="0">
                <materialDesign:PackIcon Kind="FileDocument"  Margin="20 10 0 0" Width="50" Height="50" Foreground="{DynamicResource PrimaryTextColor}"/>
                <TextBlock Text="Consulta Documentos" Margin="80 25 0 0" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextColor}" />
            </Grid>


            <!-- Cuerpo principal -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- FILTROS DE BUSQUEDA -->

                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.05*"/>
                        <ColumnDefinition Width="0.2*"/>
                        <ColumnDefinition Width="0.15*"/>
                        <ColumnDefinition Width="0.15*"/>
                        <ColumnDefinition Width="0.3*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <materialDesign:PackIcon Kind="Filter" Margin="15,20" Width="30" Height="30" Grid.Column="0" Grid.Row="0" Foreground="{DynamicResource PrimaryIconColor}"/>
                    <ComboBox x:Name="cbFilter" Grid.Column="1" Grid.Row="0" Margin="5,10"
                         Style="{StaticResource CleanOutlinedComboBox}"
                         materialDesign:HintAssist.Hint="Seleccione Filtro"
                         SelectionChanged="cbFilter_SelectionChanged"
                         Height="55"/>


                    <TextBox x:Name="txtNoDocument" 
                             Grid.Column="2" 
                             Grid.ColumnSpan="2" 
                             Margin="5,10"
                             Style="{StaticResource CleanOutlinedTextBox}"
                             FontSize="14"
                             materialDesign:HintAssist.Hint="Ingrese No Documento" 
                             Height="55" 
                             MaxLength="50" 
                             Visibility="Collapsed"
                             />


                    <DatePicker x:Name="startDate" Style="{StaticResource MaterialDesignDatePicker}"
                        Width="150"
                        BorderBrush="White"
                        BorderThickness="2"
                        FontSize="14"
                        HorizontalContentAlignment="Center"
                        Height="55"
                        Margin="5 10"
                        Grid.Column="2"
                        DisplayDateEnd="{x:Static sys:DateTime.Today}"
                        materialDesign:HintAssist.Hint="Fecha Inicial"
                        Foreground="{DynamicResource PrimaryTextColor}"
                        SelectedDate="{Binding startDate}" />

                    <DatePicker x:Name="endDate" Style="{StaticResource MaterialDesignDatePicker}"
                         Width="150"
                         BorderBrush="White"
                         BorderThickness="2"
                         FontSize="14"
                         HorizontalContentAlignment="Center"
                         Height="55"
                         Margin="5 10"
                         Grid.Column="3"
                         DisplayDateEnd="{x:Static sys:DateTime.Today}"
                         materialDesign:HintAssist.Hint="Fecha Final"
                         Foreground="{DynamicResource PrimaryTextColor}"
                         SelectedDate="{Binding endDate}" />

                    <Button x:Name="btnBuscar" Content="Buscar"
                        Grid.Column="5"
                        HorizontalAlignment="Left"
                        Style="{StaticResource SearchButtonStyle}"
                        Margin="5,10" Width="100" Click="btnBuscar_Click"/>
                </Grid>


                <!-- DATAGRID -->
                <Grid Grid.Column="0" Grid.Row="1">
                    <DataGrid x:Name="grdDocuments"  Margin="5,10"
                      Background="{DynamicResource PrimaryBackgroundColor}"
                      CanUserAddRows="False" 
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" />
                            <DataGridTextColumn Header="Empresa" Binding="{Binding Company.Name}" />
                            <DataGridTextColumn Header="Sucursal" Binding="{Binding Subsidiary.Name}" />
                            <DataGridTextColumn Header="Estado" Binding="{Binding Status}" />
                            <DataGridTextColumn Header="Doc. SAE" Binding="{Binding SAEDocumentId}" />
                            <DataGridTextColumn Header="SAE Número" Binding="{Binding SAENumber}" />
                            <DataGridTextColumn Header="SAE Serie" Binding="{Binding SAESerial}" />
                            <DataGridTextColumn Header="Fecha Envío" Binding="{Binding SendDate, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" />
                            <DataGridTextColumn Header="Tipo Documento" Binding="{Binding DocumentType}" />
                            <DataGridTextColumn Header="UUID" Binding="{Binding UUID}" />
                            <DataGridTextColumn Header="Control" Binding="{Binding ControlNumber}" />
                            <DataGridTemplateColumn Header="Acciones">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"  >
                                            <!-- Ver Detalle -->
                                            <Button ToolTip="Ver Detalle"
                                                    Margin="0,0,6,0"
                                                    Width="30" Height="25" Padding="0"
                                                    Click="BtnViewDetail_Click">
                                                <materialDesign:PackIcon Kind="EyeOutline" Width="18" Height="18"/>
                                            </Button>

                                            <!-- Descargar PDF -->
                                            <Button ToolTip="Descargar PDF"
                                                    Width="30" Height="25" Padding="0"
                                                    Click="BtnDownloadPDF_Click">
                                                <materialDesign:PackIcon Kind="Download" Width="18" Height="18"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid x:Name="LoaderOverlay"
                              Background="#CC000000"
                              Visibility="Collapsed"
                              IsHitTestVisible="True"
                              Panel.ZIndex="999">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Style="{StaticResource CustomProgressRingStyle}" />
                            <TextBlock Text="Cargando..." Foreground="White" FontSize="16" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

        </Grid>
    </Border>
</Page>
