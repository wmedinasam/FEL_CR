<Page x:Class="FELRD.Views.Pages.Subsidiary"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:local="clr-namespace:FELRD.Views.Pages"
      xmlns:all="clr-namespace:FELRD"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Subsidiary"
      TextElement.Foreground="{DynamicResource MaterialDesignBody}"
      >

    <Page.DataContext>
        <all:RegistrationVM/>
    </Page.DataContext>

    <Border CornerRadius="5" Background="{DynamicResource SecundaryBackgroundColor}">




        <StackPanel Orientation="Vertical" >
            <Grid>
                <materialDesign:PackIcon Kind="Company"  Margin="20 10 0 0" Width="50" Height="50" Foreground="{DynamicResource PrimaryTextColor}"/>
                <TextBlock Text="Datos Generales de la Sucursal" Margin="80 25 0 0" FontSize="18" FontWeight="SemiBold" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.5*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <materialDesign:PackIcon Kind="CardAccountDetails"  Margin="20,21,11.6,1.8" 
                                     Width="Auto" Height="30"
                                     VerticalAlignment="Stretch"
                                     HorizontalAlignment="Stretch"
                                     Grid.Column="0" Grid.Row="1"
                                     Foreground="{DynamicResource PrimaryTextColor}"/>


                <ComboBox x:Name="cbCompanies" 
                          Grid.Column="1" 
                          Margin="5,15,10,10"
                          HorizontalContentAlignment="Center"
                          FontSize="14"
                          Background="{StaticResource PrimaryBackgroundColor}"
                          BorderThickness="2" 
                          BorderBrush="{DynamicResource MaterialDesignDivider}" 
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Grid.ColumnSpan="2" 
                          VerticalAlignment="Stretch"
                          materialDesign:HintAssist.Hint="Seleccione Empresa" 
                          materialDesign:HintAssist.Background="{DynamicResource SecundaryBackgroundColor}"/>

                <Button x:Name="btnNew" 
                    Grid.Row="0" 
                        Grid.Column="5" 
                    HorizontalAlignment="Center" 
                    Margin="0,19,0,0" 
                    Padding="0" Width="100" 
                    Click="btnNew_Click" Height="32" VerticalAlignment="Top">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="UserAdd"  Margin="0 0 5 0" 
                            Width="25" Height="25"
                            Foreground="{DynamicResource PrimaryTextColor}"/>

                            <TextBlock Text="Nuevo" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </StackPanel>

                    </Button.Content>
                </Button>

                <TextBox 
                Text="{Binding IdType, ValidatesOnExceptions=True, 
                UpdateSourceTrigger=PropertyChanged}"
                MaxLength="100"
                Margin="5,5,38,10"
                x:Name="txtEstablishmentName" 
                Grid.Column="1" Grid.Row="1"
                Grid.ColumnSpan="6"
                Background="{StaticResource PrimaryBackgroundColor}"
                FontSize="14" materialDesign:HintAssist.Hint="Ingrese Nombre del Establecimiento" 
                BorderThickness="2" BorderBrush="{DynamicResource MaterialDesignDivider}" 
                Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                materialDesign:HintAssist.Background="{DynamicResource SecundaryBackgroundColor}"
                />

                <materialDesign:PackIcon Kind="MapMarker"  Margin="20,32.2,11.6,12.2" 
                                     Width="Auto" Height="30"
                                     VerticalAlignment="Stretch"
                                     HorizontalAlignment="Stretch"
                                     Grid.Column="0" Grid.Row="2"
                                     Foreground="{DynamicResource PrimaryTextColor}"/>

                <TextBox 
                Text="{Binding Province, ValidatesOnExceptions=True, 
                UpdateSourceTrigger=PropertyChanged}"
                HorizontalContentAlignment="Center"
                Grid.Column="1" Grid.Row="2"
                MaxLength="5"
                Margin="5,15,10,12"
                x:Name="txtEstablishmentCode" 
                Background="{StaticResource PrimaryBackgroundColor}"
                FontSize="14" materialDesign:HintAssist.Hint="Codigo Establecimiento" 
                BorderThickness="2" BorderBrush="{DynamicResource MaterialDesignDivider}"
                materialDesign:HintAssist.Background="{DynamicResource SecundaryBackgroundColor}"
                Style="{StaticResource MaterialDesignOutlinedTextBox}" Grid.ColumnSpan="2" 
               />

                <TextBox 
                Text="{Binding Canton, ValidatesOnExceptions=True, 
                UpdateSourceTrigger=PropertyChanged}"  
                x:Name="txtPostalCode"
                HorizontalContentAlignment="Center"
                MaxLength="6"
                Grid.Column="3" Grid.Row="2"
                Margin="10,15,10,12"
                FontSize="14" materialDesign:HintAssist.Hint="Codigo Postal" 
                Background="{StaticResource PrimaryBackgroundColor}"
                BorderThickness="2" BorderBrush="{DynamicResource MaterialDesignDivider}" 
                materialDesign:HintAssist.Background="{DynamicResource SecundaryBackgroundColor}"
                Style="{StaticResource MaterialDesignOutlinedTextBox}" Grid.ColumnSpan="2" />


                <ComboBox 
                 x:Name="cbCountry"
                HorizontalContentAlignment="Center"
                Margin="10,15,38,12"
                Grid.Column="5" Grid.Row="2"
                Background="{StaticResource PrimaryBackgroundColor}"
                BorderThickness="2" 
                BorderBrush="{DynamicResource MaterialDesignDivider}" 
                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                Grid.ColumnSpan="2" 
                materialDesign:HintAssist.Hint="Seleccione País" 
                materialDesign:HintAssist.Background="{DynamicResource SecundaryBackgroundColor}"
                />


                <materialDesign:PackIcon Kind="File"  Margin="20,31.8,11.6,11.8" 
                                     Width="Auto" Height="30"
                                     VerticalAlignment="Stretch"
                                     HorizontalAlignment="Stretch"
                                     Grid.Column="0" Grid.Row="3"
                                     Foreground="{DynamicResource PrimaryTextColor}"/>


                <TextBox 
                Text="{Binding CountryCode, ValidatesOnExceptions=True, 
                UpdateSourceTrigger=PropertyChanged}"  
                x:Name="txtSubsidiaryFolder"
                HorizontalContentAlignment="Center"
                MaxLength="150"
                Grid.Column="1" Grid.Row="3"
                Margin="2,8,40,12"
                FontSize="14" materialDesign:HintAssist.Hint="Folder Sucursal" 
                Background="{StaticResource PrimaryBackgroundColor}"
                BorderThickness="2" BorderBrush="{DynamicResource MaterialDesignDivider}" 
                materialDesign:HintAssist.Background="{DynamicResource SecundaryBackgroundColor}"
                Style="{StaticResource MaterialDesignOutlinedTextBox}" Grid.ColumnSpan="6" />



                <materialDesign:PackIcon Kind="Company"  Margin="20,32.2,11.6,11.4" 
                                     Width="Auto" Height="30"
                                     VerticalAlignment="Stretch"
                                     HorizontalAlignment="Stretch"
                                     Grid.Column="0" Grid.Row="0"
                                     Foreground="{DynamicResource PrimaryTextColor}"/>

                <Button Margin="10,8,40,9"  
                    x:Name="btnAceptar" 
                    Style="{StaticResource MaterialDesignFlatMidBgButton}" 
                    materialDesign:ShadowAssist.ShadowDepth="Depth0"
                    Grid.Column="5" Grid.Row="4"
                    Grid.ColumnSpan="2"
                    materialDesign:ButtonAssist.CornerRadius="10" 
                    FontSize="18" Click="btnAceptar_Click">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave"  Margin="0 0 10 0" 
                                     Width="25" Height="25"
                                     Foreground="{DynamicResource PrimaryTextColor}"/>

                            <TextBlock Text="Guardar"/>
                        </StackPanel>

                    </Button.Content>

                </Button>
                <DataGrid x:Name="grdSubsidiary"
        Background="{DynamicResource PrimaryBackgroundColor}"
    Margin="10,5,40,10" Grid.Column="1" Grid.Row="6"
    CanUserAddRows="False" AutoGenerateColumns="False" IsReadOnly="True" Grid.ColumnSpan="6" Height="120">
                    <DataGrid.Columns >
                        <DataGridTextColumn Header="Nombre Establecimiento" Binding="{Binding EstablishmentName}"/>
                        <DataGridTemplateColumn Header="Acción">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" ScrollViewer.CanContentScroll="True">
                                        <Button  BorderBrush="White" ToolTip="Editar Registro" BorderThickness="1" Cursor="Arrow" Width="30" Padding="0" Height="25" Click="Button_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Edit" Height="18" Width="14"></materialDesign:PackIcon>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

            </Grid>

        </StackPanel>

    </Border>
</Page>
