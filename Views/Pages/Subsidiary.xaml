<Page x:Class="FELRD.Views.Pages.Subsidiary"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:local="clr-namespace:FELRD.Views.Pages"
      xmlns:all="clr-namespace:FELRD"
      mc:Ignorable="d" 
      d:DesignHeight="768" d:DesignWidth="1024"
      Title="Subsidiary">

    <Page.DataContext>
        <all:RegistrationVM/>
    </Page.DataContext>

    <Border CornerRadius="5" Background="{DynamicResource SecundaryBackgroundColor}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <Grid Grid.Row="0">
                <materialDesign:PackIcon Kind="LocationMultiple" Margin="20 10 0 0" Width="50" Height="50" Foreground="{DynamicResource PrimaryTextColor}"/>
                <TextBlock Text="Sucursales" Margin="80 25 0 0" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextColor}"/>
            </Grid>

            <!-- Cuerpo con formulario y datagrid -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*"/>
                    <ColumnDefinition Width="1.1*"/>
                </Grid.ColumnDefinitions>

                <!-- FORMULARIO -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Column="0">
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.15*"/>
                            <ColumnDefinition Width="0.85*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <materialDesign:PackIcon Kind="Company" Margin="30,20" Width="30" Height="30" Grid.Column="0" Grid.Row="0" Foreground="{DynamicResource PrimaryIconColor}"/>
                        <ComboBox x:Name="cbCompanies" Grid.Column="1" Grid.Row="0" Margin="5,10"
                                  Style="{StaticResource CleanOutlinedComboBox}"
                                  materialDesign:HintAssist.Hint="Seleccione Empresa"/>

                        <materialDesign:PackIcon Kind="CardAccountDetails" Margin="30,20" Width="30" Height="30" Grid.Column="0" Grid.Row="1" Foreground="{DynamicResource PrimaryIconColor}"/>
                        <TextBox x:Name="txtEstablishmentName" Grid.Column="1" Grid.Row="1" Margin="5,10"
                                 Style="{StaticResource CleanOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Ingrese Nombre del Establecimiento" MaxLength="100"/>

                        <materialDesign:PackIcon Kind="Numeric" Margin="30,20" Width="30" Height="30" Grid.Column="0" Grid.Row="2" Foreground="{DynamicResource PrimaryIconColor}"/>
                        <TextBox x:Name="txtEstablishmentCode" Grid.Column="1" Grid.Row="2" Margin="5,10"
                                 Style="{StaticResource CleanOutlinedTextBox}" MaxLength="5"
                                 materialDesign:HintAssist.Hint="Codigo Establecimiento"/>

                        <materialDesign:PackIcon Kind="MapMarker" Margin="30,20" Width="30" Height="30" Grid.Column="0" Grid.Row="3" Foreground="{DynamicResource PrimaryIconColor}"/>
                        <TextBox x:Name="txtPostalCode" Grid.Column="1" Grid.Row="3" Margin="5,10"
                                 Style="{StaticResource CleanOutlinedTextBox}" MaxLength="6"
                                 materialDesign:HintAssist.Hint="Codigo Postal"/>

                        <materialDesign:PackIcon Kind="Map" Margin="30,20" Width="30" Height="30" Grid.Column="0" Grid.Row="4" Foreground="{DynamicResource PrimaryIconColor}"/>
                        <ComboBox x:Name="cbCountry" Grid.Column="1" Grid.Row="4" Margin="5,10"
                                  Style="{StaticResource CleanOutlinedComboBox}"
                                  materialDesign:HintAssist.Hint="Seleccione País" Loaded="cbCountry_Loaded"/>

                        <materialDesign:PackIcon Kind="Folder" Margin="30,20" Width="30" Height="30" Grid.Column="0" Grid.Row="5" Foreground="{DynamicResource PrimaryIconColor}"/>
                        <Grid Grid.Column="1" Grid.Row="5" Margin="5,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.7*"/>
                                <ColumnDefinition Width="0.3*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtSubsidiaryFolder" Grid.Column="0" MaxLength="150"
                                     Style="{StaticResource CleanOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Folder Sucursal"/>
                            <Button x:Name="btnFolder" Grid.Column="1" Margin="5,0,0,0"
                                    Style="{StaticResource BrowseButtonStyle}"
                                    Click="BrowseSubsidiaryFolder_Click">
                                <materialDesign:PackIcon Kind="Folder" Width="20" Height="20"/>
                            </Button>
                        </Grid>

                        <Button x:Name="btnAceptar" Grid.Column="1" Grid.Row="6" Margin="5,45"
                                Style="{StaticResource SaveButtonStyle}" Width="250"
                                Content="Guardar" Click="btnAceptar_Click"/>
                    </Grid>
                </ScrollViewer>

                <!-- DATAGRID -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="btnNew" Grid.Row="0" Margin="5,10" Width="150"
                            Style="{StaticResource NewButtonStyle}" Content="Nuevo"
                            Click="btnNew_Click" HorizontalAlignment="Left"/>

                    <DataGrid x:Name="grdSubsidiary" Grid.Row="1" Margin="5,10"
                              Background="{DynamicResource PrimaryBackgroundColor}"
                              CanUserAddRows="False" AutoGenerateColumns="False" IsReadOnly="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre Establecimiento" Binding="{Binding EstablishmentName}"/>
                            <DataGridTemplateColumn Header="Acción">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button ToolTip="Editar Registro" Width="30" Height="25" Padding="0" Click="Button_Click">
                                                <materialDesign:PackIcon Kind="Edit" Height="18" Width="14"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Page>