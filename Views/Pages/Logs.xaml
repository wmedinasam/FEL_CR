<Page x:Class="FELRD.Views.Pages.Logs"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FELRD.Views.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Logs">
    <Border CornerRadius="5" Background="{DynamicResource SecundaryBackgroundColor}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
        <StackPanel Orientation="Vertical">
            <Grid>
                <materialDesign:PackIcon Kind="TimelineClockOutline"  Margin="20 10 0 0" Width="50" Height="50" Foreground="{DynamicResource PrimaryTextColor}"/>
                <TextBlock Text="Consulta Logs del Sistema" Margin="80 25 0 0" FontSize="18" FontWeight="SemiBold" />
            </Grid>
            <Grid Height="480">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="6*"/>
                </Grid.RowDefinitions>
                <Grid HorizontalAlignment="Center" Grid.Row="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBox
            x:Name="txtFilePath" 
            VerticalAlignment="Stretch"
            Height="55"
            Width="450"
            Margin="20,5,0,0"
            Background="{StaticResource PrimaryBackgroundColor}"            
            FontSize="14" materialDesign:HintAssist.Hint="Ingrese Ruta del Achivo"             
            Style="{StaticResource CleanOutlinedTextBox}"
            />
                        <Button
                x:Name="btnSearchFile" Margin="10 0 0 0" 
                Style="{StaticResource MaterialDesignFlatAccentBgButton}" 
                materialDesign:ShadowAssist.ShadowDepth="Depth0" 
                Width="100"
                materialDesign:ButtonAssist.CornerRadius="5" 
                FontSize="14"
                Click="btnSearchFile_Click"
                    >
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Search"  Margin="0 0 5 0" 
                                 Width="20" Height="20"
                                 Foreground="{DynamicResource PrimaryTextColor}"/>

                                    <TextBlock Text="Buscar"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </StackPanel>

                </Grid>

                <ScrollViewer Grid.Row="1">
                    <RichTextBox x:Name="rtbLog"
                 Background="{DynamicResource PrimaryBackgroundColor}"
                 Margin="10 10 10 10"
                 />
                </ScrollViewer>
            </Grid>


        </StackPanel>
    </Border>
</Page>
